# VEXCollab configuration.
#
# Copy to .env.local for local use (it is gitignored), or put these in
# /etc/vexcollab.env on a server. Everything here is optional — with an empty
# file you get an open, password-free instance on http://localhost:3000.

# ── Where it listens ─────────────────────────────────────────────────────────
PORT=3000
# 0.0.0.0 lets your Wi-Fi reach it. Behind a reverse proxy use 127.0.0.1 so the
# app is not directly reachable from the internet.
HOST=0.0.0.0

# ── Access ───────────────────────────────────────────────────────────────────
# Leave empty for no password. Set one for anything reachable beyond your desk.
# Gates the page and the collaboration socket; 10 tries per IP per 15 minutes.
VEXCOLLAB_PASSWORD=

# ── TLS ──────────────────────────────────────────────────────────────────────
# 1 serves HTTPS with a self-signed certificate, so WebSerial works on your
# Wi-Fi address and not just localhost. Not needed behind Caddy/nginx.
VEXCOLLAB_HTTPS=0
# 1 when a reverse proxy terminates TLS, so cookies get Secure and the real
# client IP is used for rate limiting.
VEXCOLLAB_TRUST_PROXY=0

# ── Storage ──────────────────────────────────────────────────────────────────
# Where repositories checked out for a room live.
VEXCOLLAB_DATA_DIR=./.vexcollab-data

# ── GitHub ───────────────────────────────────────────────────────────────────
# Optional. Without these, GitHub still works via a pasted token — Settings has
# a one-click link that opens GitHub with the right scope ticked.
#
# For a real "Sign in with GitHub" button, register an OAuth app at
#   https://github.com/settings/developers
# with callback URL  <your address>/api/github/callback
VEXCOLLAB_GITHUB_CLIENT_ID=
VEXCOLLAB_GITHUB_CLIENT_SECRET=

# ── Copilot ──────────────────────────────────────────────────────────────────
# 1 runs GitHub's official Copilot language server for inline suggestions.
# Needs your own Copilot subscription.
VEXCOLLAB_COPILOT=0
