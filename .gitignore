node_modules/
.next/
out/
build/
.DS_Store
*.pem
npm-debug.log*
.env*.local
next-env.d.ts
.vercel
*.tsbuildinfo

# Per-user runtime state. The Copilot language server keeps its OAuth token in
# .vexcollab-data/copilot/<user>/.config/github-copilot/auth.db — committing
# that publishes a live GitHub credential, which is exactly what happened once.
.vexcollab-data/

# The konh.org website is a separate, private project. It is deployed to the
# same Pi by deploy/pi/publish-site.sh, but its files must never be committed
# here — this repo is AGPL and public.
konh-site/
konh.org-static*
/site/
/www/

# VEX Robotics' own installers and unpacked software. Proprietary: its licence
# forbids redistribution as well as reverse engineering, so a copy sitting in
# the working tree must never reach this public repo.
*.exe
VEXcode*/
